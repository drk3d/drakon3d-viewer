{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drakon3d-share",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "vars": {
    "VIEWER_ORIGIN": "https://viewer.drakon3d.com"
  },
  "r2_buckets": [
    {
      "binding": "SHARES",
      "bucket_name": "drakon3d-shares"
    }
  ]
}
